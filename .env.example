//Cadena de conexion
DATABASE_URL = postgresql://postgres:Uisrael.@localhost:5432/talenthub_dev
// gestor: usario: contraseña @ servidor puerto base de datos 
PORT = 3000
// Variable para la ejecucion de pruebas
TEST_DATABASE_URL = postgresql://postgres:Uisrael.@localhost:5432/talenthub_dev_test

// MONGO DB
MONGODB_URI = mongodb://localhost:27017/talenthub_dev
MONGODB_TEST_URI = mongodb://localhost:27017/talenthub_dev_test

//Almacenamiento de cada modulo. Si la variable no existe, se usa la opcion por defecto.
//Vacancies: prisma usa PostgreSQL con Prisma (por defecto: PostgreSQL con pg)
VACANCIES_ADAPTER = prisma
//Companies: prisma usa PostgreSQL con Prisma (por defecto: MongoDB, o memoria si no hay MONGODB_URI)
COMPANIES_ADAPTER = prisma
//Candidates: prisma usa PostgreSQL con Prisma, sql usa PostgreSQL con pg (por defecto: memoria)
CANDIDATES_ADAPTER = prisma

CORS_ORIGIN = http://localhost:5173